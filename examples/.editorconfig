# Kernel coding style for the driver examples, following the kernel tree's
# own .editorconfig. See https://editorconfig.org.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[{*.{c,h,mk},Kconfig,Makefile}]
indent_style = tab
indent_size = 8

[*.sh]
indent_style = space
indent_size = 4
